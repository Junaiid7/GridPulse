# GridPulse environment configuration.
# Copy to `.env` for local development (never commit `.env`).
# Placeholders only — never store real credentials here or in code.

# Runtime -----------------------------------------------------------------
# Optional override for where project data lives.
GRIDPULSE_DATA_DIR=
GRIDPULSE_LOG_LEVEL=INFO

# HTTP client tuning (optional, sensible defaults in config.py)
GRIDPULSE_HTTP_TIMEOUT_S=30.0
GRIDPULSE_HTTP_RETRIES=3

# ENTSO-E Transparency Platform ------------------------------------------
# Required for all ENTSO-E data (load, generation, prices, flows, imbalance).
# Get your key at https://transparency.entsoe.eu/content/Getting_started/
ENTSOE_API_KEY=

# MLflow tracking server (future phase)
MLFLOW_TRACKING_URI=
