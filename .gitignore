# ---- Project data: never commit datasets -----------------------------
# Data lives in data/{bronze,silver,gold}. Ignore everything under each
# tier but keep the directories themselves via .gitkeep.
/data/bronze/*
/data/silver/*
/data/gold/*
!/data/bronze/.gitkeep
!/data/silver/.gitkeep
!/data/gold/.gitkeep